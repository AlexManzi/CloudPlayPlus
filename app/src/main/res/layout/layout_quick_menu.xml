<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/quickMenuContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#99000000" android:clickable="true" android:focusable="true">
 <LinearLayout android:id="@+id/quickMenuPanel" android:layout_width="1dp" android:layout_height="1dp" android:layout_gravity="center" android:orientation="vertical" android:background="@drawable/quick_menu_panel" android:elevation="16dp" android:padding="20dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
   <TextView android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="☁" android:textColor="#FFFFFF" android:textSize="27sp"/>
   <TextView android:id="@+id/quickMenuTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Quick Menu" android:textColor="#FFFFFF" android:textSize="29sp" android:textStyle="bold"/>
   <TextView android:id="@+id/quickMenuHeaderStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="18dp" android:textColor="#B9C0CD" android:textSize="16sp"/>
   <Button android:id="@+id/quickMenuClose" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/quick_menu_icon" android:text="×" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="31sp"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/quickMenuNotes" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="12dp" android:background="@drawable/quick_menu_card" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
   <TextView android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/quick_menu_icon" android:gravity="center" android:text="▤" android:textColor="#FFFFFF" android:textSize="25sp"/>
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notes" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View or add notes for this game" android:textColor="#AEB6C5" android:textSize="14sp"/></LinearLayout>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#FFFFFF" android:textSize="34sp"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/quickMenuDiscord" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="10dp" android:background="@drawable/quick_menu_card" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
   <TextView android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/quick_menu_icon_discord" android:gravity="center" android:text="☻" android:textColor="#FFFFFF" android:textSize="24sp"/>
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/quickMenuDiscordTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Turn On Discord" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/><TextView android:id="@+id/quickMenuDiscordSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enable the four-tap Discord shortcut" android:textColor="#AEB6C5" android:textSize="14sp"/></LinearLayout>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#FFFFFF" android:textSize="34sp"/>
  </LinearLayout>
  <View android:id="@+id/quickMenuDivider" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:layout_marginBottom="12dp" android:background="#3D4655"/>
  <TextView android:id="@+id/quickMenuCasHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✦  Image Sharpening" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:orientation="horizontal"><Button android:id="@+id/quickMenuCasOff" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/quick_menu_segment" android:text="Off" android:textAllCaps="false" android:textColor="#D2D2D2" android:textSize="17sp"/><Button android:id="@+id/quickMenuCasNormal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/quick_menu_segment_selected" android:text="Normal" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="17sp"/><Button android:id="@+id/quickMenuCasHigh" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/quick_menu_segment" android:text="High" android:textAllCaps="false" android:textColor="#D2D2D2" android:textSize="17sp"/></LinearLayout>
  <LinearLayout android:id="@+id/quickMenuStatsCard" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="14dp" android:background="@drawable/quick_menu_card" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="18dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Stream Stats" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#FFFFFF" android:textSize="34sp"/></LinearLayout>
  <TextView android:id="@+id/quickMenuFooter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Tap outside or press Back to close" android:textColor="#8993A5" android:textSize="13sp"/>
  <LinearLayout android:id="@+id/quickMenuStatsPage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="18dp" android:orientation="vertical" android:visibility="gone">
   <Button android:id="@+id/quickMenuStatsBack" android:layout_width="120dp" android:layout_height="46dp" android:background="@drawable/quick_menu_segment" android:text="‹  Back" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="17sp"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Stream Statistics" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
   <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="18dp">
    <TextView android:id="@+id/quickMenuFullStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/quick_menu_card" android:padding="20dp" android:textColor="#D7DDEA" android:textSize="17sp" android:typeface="monospace"/>
   </ScrollView>
  </LinearLayout>
 </LinearLayout>
</FrameLayout>
